# Cesium ion access token. REQUIRED — without it the globe loads no terrain,
# no imagery and no OSM Buildings, and the app shows an explanatory banner.
# Free token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Cesium ion asset id for the global OSM Buildings tileset. The default is
# Cesium's public one; override only if you host your own.
VITE_OSM_BUILDINGS_ASSET_ID=96188

# Base URL of the @gme/server API.
#
# Leave EMPTY to run with no backend: footprints are then fetched straight from
# the public Overpass endpoint and nothing is persisted. Fine for development,
# not for production — see the Overpass note in the README.
#
# Set to an empty-path value like "" plus the dev proxy, or to an absolute URL.
VITE_API_BASE_URL=

# Where `vite dev` proxies /api when VITE_API_BASE_URL is a relative path.
VITE_API_PROXY_TARGET=http://localhost:8787
