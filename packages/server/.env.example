PORT=8787

# Postgres + PostGIS. Leave EMPTY to use the in-memory repository, which loses
# everything on restart but needs no database to be running.
DATABASE_URL=postgres://gme:gme@localhost:5432/gme

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# MUST be true in production; the server refuses to start otherwise. When false
# every request is attributed to a single anonymous user.
# Wiring a real provider means replacing `verifyToken` in src/auth/middleware.ts.
AUTH_REQUIRED=false

# --- Overpass ---------------------------------------------------------------
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_CACHE_TTL_MS=86400000
OVERPASS_CACHE_MAX=5000
OVERPASS_TIMEOUT_MS=30000

# --- Object storage ---------------------------------------------------------
# Setting S3_BUCKET switches the storage driver from local disk to S3.
# S3_BUCKET=geo-model-editor
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000        # MinIO / R2; enables path-style URLs
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com   # skip presigning via a CDN

# Directory used when no bucket is configured.
LOCAL_STORAGE_DIR=.storage
